# ===========================
# DATABASE
# ===========================
DATABASE_URL="postgresql://user:password@localhost:5432/mt5_trading_bot"

# ===========================
# SERVER
# ===========================
NODE_ENV="development"
PORT=5000
FRONTEND_URL="http://localhost:3000"

# ===========================
# JWT
# ===========================
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this"
JWT_REFRESH_EXPIRES_IN="7d"

# ===========================
# MT5 INTEGRATION
# ===========================
# This is the secret key for MT5 EA authentication
# Generate a strong random string and keep it secure
MT5_EA_SECRET="your-mt5-ea-secret-key-change-this"

# ===========================
# NOTIFICATION SERVICES
# ===========================
# Telegram (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ===========================
# EXTERNAL SERVICES
# ===========================
# Add any other external service keys here as needed

# ===========================
# LOGGING
# ===========================
LOG_LEVEL="info"
